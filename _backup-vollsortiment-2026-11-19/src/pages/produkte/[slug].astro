---
import Subpage from '../../layouts/Subpage.astro';
import { productPages } from '../../data/pages';
export function getStaticPaths() {
  return productPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<Subpage page={page} section="Produkte" sectionHref="/produkte/etikettiersysteme/" />
