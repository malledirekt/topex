---
// Reparatur-Anfrage (nach Vorbild topex.de) – sendet wie das Kontaktformular an /api/lead.php
const field = 'w-full border border-ink/15 bg-white px-4 py-3.5 text-ink placeholder:text-ink/35 outline-none transition-colors focus:border-brand';
const devices = ['topex Drucker', 'topex Spender', 'Tischdrucker (Zebra / Honeywell / …)', 'Steuerung', 'Laser und Laserzubehör', 'Thermoleiste', 'Anderes'];
---
<form id="repair-form" class="marks relative border border-line bg-white p-6 text-brand shadow-[0_30px_80px_-40px_rgb(18_19_23/.35)] sm:p-10" action="/api/lead.php" method="post" novalidate>
  <input type="hidden" name="interest" value="Reparatur-Anfrage" />
  <div class="grid gap-5 text-ink sm:grid-cols-2">
    <label class="block"><span class="label text-steel">Firma</span><input name="company" autocomplete="organization" class={`mt-2 ${field}`} /></label>
    <label class="block"><span class="label text-steel">Ansprechpartner *</span><input name="name" required autocomplete="name" class={`mt-2 ${field}`} /></label>
    <label class="block"><span class="label text-steel">E-Mail *</span><input name="email" type="email" required autocomplete="email" class={`mt-2 ${field}`} /></label>
    <label class="block"><span class="label text-steel">Telefon</span><input name="phone" type="tel" autocomplete="tel" class={`mt-2 ${field}`} /></label>
    <label class="block sm:col-span-2"><span class="label text-steel">Bezugsnummer</span><input name="ref" class={`mt-2 ${field}`} placeholder="Ihre Referenz-, Bestell- oder Vorgangsnummer" /></label>
    <label class="block"><span class="label text-steel">Was möchten Sie einsenden?</span>
      <select name="device" class={`mt-2 ${field} appearance-none`}>
        <option value="">Bitte wählen</option>
        {devices.map((d) => <option>{d}</option>)}
      </select>
    </label>
    <label class="block"><span class="label text-steel">Typ / Modell</span><input name="model" class={`mt-2 ${field}`} placeholder="z. B. 7054, 7108, 7162, 7200" /></label>
    <label class="block"><span class="label text-steel">Seriennr.</span><input name="serial" class={`mt-2 ${field}`} /></label>
    <label class="block"><span class="label text-steel">Anlagennr.</span><input name="plant" class={`mt-2 ${field}`} /></label>
    <label class="block sm:col-span-2"><span class="label text-steel">Fehlerbeschreibung *</span><textarea name="message" rows="6" required class={`mt-2 ${field} resize-y`} placeholder="Was funktioniert nicht? Sind sichtbare Schäden zu erkennen?"></textarea></label>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="t" value="0" />
    <label class="flex items-start gap-3 text-sm text-ink/65 sm:col-span-2">
      <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 accent-[#832181]" />
      <span>Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verwendet werden. Mehr in der <a href="/datenschutz/" class="underline hover:text-brand">Datenschutzerklärung</a>. *</span>
    </label>
  </div>
  <div class="mt-8 flex flex-wrap items-center gap-5">
    <button type="submit" class="btn btn-primary"><span>Reparatur anfragen</span><span class="arrow" aria-hidden="true">→</span></button>
    <p id="repair-status" class="text-sm text-ink/70" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  const form = document.getElementById('repair-form') as HTMLFormElement | null;
  if (form) {
    const started = Date.now();
    const status = document.getElementById('repair-status')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { status.textContent = 'Bitte füllen Sie alle Pflichtfelder (*) aus.'; form.reportValidity(); return; }
      (form.elements.namedItem('t') as HTMLInputElement).value = String(Date.now() - started);
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true; status.textContent = 'Wird gesendet …';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) { form.reset(); status.textContent = 'Vielen Dank! Wir melden uns in Kürze bei Ihnen.'; }
        else status.textContent = 'Das hat leider nicht geklappt. Bitte rufen Sie uns an oder schreiben Sie eine E-Mail.';
      } catch { status.textContent = 'Keine Verbindung. Bitte versuchen Sie es erneut.'; }
      btn.disabled = false;
    });
  }
</script>
