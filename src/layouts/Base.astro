---
import '../styles/global.css';
import { site, nav, products } from '../data/site';
import interLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';

interface Props { title: string; description: string; schema?: object[]; noindex?: boolean; }
const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const year = new Date().getFullYear();

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': site.url + '/#organization',
  name: site.name,
  alternateName: ['topex systems', 'topex-systems Kennzeichnungssysteme'],
  legalName: site.legalName,
  url: site.url + '/',
  logo: site.url + '/img/logo-topex-systems.png',
  telephone: site.phone,
  email: site.email,
  description: 'Etikettier-, Laser- und RFID-Systeme sowie Etiketten und Transferfolien für die industrielle Kennzeichnung und Identifizierung von Bauteilen.',
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, postalCode: site.address.zip, addressLocality: site.address.city, addressCountry: site.address.country },
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Produkte', itemListElement: products.map((p) => ({ '@type': 'OfferCatalog', name: p.title, description: p.text })) },
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': site.url + '/#website', url: site.url + '/', name: 'topex-systems', inLanguage: 'de-DE', publisher: { '@id': site.url + '/#organization' } };
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <link rel="alternate" hreflang="de" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="topex-systems" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={site.url + '/img/logo-topex-systems.png'} />
  <meta name="theme-color" content="#0e0f12" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  <script type="application/ld+json" set:html={JSON.stringify(website)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body class="bg-paper text-ink">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-brand focus:text-white focus:px-4 focus:py-2">Zum Inhalt springen</a>

  <header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-500 data-[scrolled=true]:bg-white/85 data-[scrolled=true]:backdrop-blur-md data-[scrolled=true]:border-line">
    <div class="mx-auto flex h-20 max-w-[90rem] items-center justify-between gap-6 px-5 sm:px-8 lg:px-12">
      <a href="/" class="shrink-0" aria-label="topex-systems – Startseite">
        <img src="/img/logo-topex-systems.webp" alt="topex-systems" width="56" height="56" class="h-14 w-14" />
      </a>
      <nav aria-label="Hauptnavigation" class="hidden lg:block">
        <ul class="flex items-center gap-8 text-[0.92rem] font-medium text-ink/70">
          {nav.map((n) => <li><a href={n.href} class="transition-colors hover:text-brand">{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="flex items-center gap-3">
        <a href="#kontakt" class="btn btn-primary !py-3 !px-4 text-sm"><span>Anfrage<span class="hidden sm:inline"> senden</span></span><span class="arrow" aria-hidden="true">→</span></a>
        <button id="menu-btn" class="lg:hidden inline-flex h-11 w-11 items-center justify-center border border-ink/15 bg-white/70" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
          <span class="block h-px w-5 bg-ink shadow-[0_6px_0_var(--color-ink)] -translate-y-[3px]"></span>
        </button>
      </div>
    </div>
    <div id="mobile-menu" hidden class="lg:hidden border-t border-line bg-white">
      <ul class="px-5 py-4 sm:px-8">
        {nav.map((n) => <li><a href={n.href} class="flex items-center justify-between border-b border-line py-4 text-lg">{n.label}<span class="text-brand">→</span></a></li>)}
      </ul>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="on-dark bg-ink text-white">
    <div class="mx-auto grid max-w-[90rem] gap-12 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:px-12">
      <div class="lg:col-span-4">
        <img src="/img/logo-topex-systems.webp" alt="topex-systems" width="88" height="88" class="h-22 w-22" loading="lazy" />
        <p class="mt-6 max-w-sm text-white/60">Systemlieferant für industrielle Kennzeichnung: Etikettier-, Laser- und RFID-Systeme sowie Etiketten und Transferfolien.</p>
      </div>
      <div class="lg:col-span-3">
        <p class="label text-steel">Produkte</p>
        <ul class="mt-4 space-y-2 text-white/75">
          {products.map((p) => <li><a href={`/#${p.id}`} class="hover:text-white">{p.title}</a></li>)}
        </ul>
      </div>
      <div class="lg:col-span-3">
        <p class="label text-steel">Kontakt</p>
        <address class="mt-4 not-italic text-white/75 leading-relaxed">
          {site.legalName}<br />
          {site.address.street}<br />
          {site.address.zip} {site.address.city}<br />
          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-white">{site.phoneDisplay}</a><br />
          <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
        </address>
      </div>
      <div class="lg:col-span-2">
        <p class="label text-steel">Rechtliches</p>
        <ul class="mt-4 space-y-2 text-white/75">
          <li><a href="/impressum/" class="hover:text-white">Impressum</a></li>
          <li><a href="/datenschutz/" class="hover:text-white">Datenschutz</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-line-light">
      <div class="mx-auto flex max-w-[90rem] flex-col gap-2 px-5 py-6 text-sm text-white/45 sm:flex-row sm:justify-between sm:px-8 lg:px-12">
        <span>© {year} topex-systems · eine Marke der {site.legalName}</span>
        <span class="label">Made in Germany</span>
      </div>
    </div>
  </footer>

  <script>
    import Lenis from 'lenis';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const lenis = new Lenis({ duration: 1.1, anchors: { offset: -80 } });
      const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
    }
    const header = document.getElementById('site-header')!;
    const onScroll = () => { header.dataset.scrolled = String(window.scrollY > 40); };
    onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

    const btn = document.getElementById('menu-btn')!;
    const menu = document.getElementById('mobile-menu')!;
    btn.addEventListener('click', () => {
      const open = menu.hidden; menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      header.dataset.scrolled = open ? 'true' : String(window.scrollY > 40);
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }));

    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  </script>
</body>
</html>
